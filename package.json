{
  "name": "cyc-afterhours",
  "version": "0.2.3",
  "private": true,
  "scripts": {
    "dev": "node scripts/show-ip.js && next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "db:migrate:local": "wrangler d1 execute cyc-afterhours --local --file=schema/climbs.sql",
    "db:migrate": "wrangler d1 execute cyc-afterhours --remote --file=schema/climbs.sql"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.6",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "aws4fetch": "^1.0.20",
    "gsap": "^3.15.0",
    "next": "^16.3.5",
    "next-themes": "^0.4.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1",
    "three-bvh-csg": "^0.0.18"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/node": "^22.20.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "autoprefixer": "^10.4.22",
    "eslint": "^9",
    "eslint-config-next": "^16.3.5",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.7",
    "typescript": "^5",
    "wrangler": "^4.125.0"
  }
}